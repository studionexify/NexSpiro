{
  "name": "nexspiro",
  "productName": "NexSpiro",
  "version": "0.1.0",
  "description": "NexSpiro — 3D printing slicer",
  "main": "electron/dist/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc -p electron/tsconfig.json && vite build && node scripts/build-electron.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "electron:dev": "node scripts/build-electron.mjs && concurrently -k \"vite --port 5173 --strictPort\" \"wait-on http://localhost:5173 && cross-env NEXSPIRO_DEV_URL=http://localhost:5173 electron .\"",
    "electron:build": "npm run build && electron-builder",
    "build:electron": "node scripts/build-electron.mjs",
    "hanex:prints": "cross-env HANEX_TEST_PRINTS=out/hanex vitest run tests/hanex/calibration.test.ts"
  },
  "build": {
    "appId": "com.nexspiro.app",
    "productName": "NexSpiro",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/dist/**",
      "electron/preload.cjs"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png",
      "category": "public.app-category.graphics-design"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Graphics",
      "maintainer": "NexSpiro"
    },
    "asar": true,
    "publish": null
  },
  "devDependencies": {
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "aedes": "^0.51.3",
    "basic-ftp": "^5.3.1",
    "clipper-lib": "^6.4.2",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.21.5",
    "ftp-srv": "^4.6.3",
    "jszip": "^3.10.1",
    "mqtt": "^5.16.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0",
    "three-bvh-csg": "^0.0.17",
    "three-gpu-pathtracer": "^0.0.23",
    "three-mesh-bvh": "^0.9.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "wait-on": "^8.0.1",
    "zustand": "^4.5.5"
  },
  "author": "NexSpiro",
  "homepage": "https://github.com/studionexify/NexSpiro",
  "dependencies": {
    "bwip-js": "^4.11.4",
    "opentype.js": "^1.3.4"
  }
}
